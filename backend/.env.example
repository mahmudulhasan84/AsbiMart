# AsbiMart Real Auth & OTP Configuration Template
PORT=5000
BASE_URL=http://localhost:5000
AUTH_SECRET=change_this_to_a_long_random_secret_string

# 0. Auth0 Universal Login (https://auth0.com)
# Redirect URI: http://localhost:5000/api/auth/auth0/callback, https://asbimart.pages.dev/api/auth/auth0/callback
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=

# Admin Panel
ADMIN_USER=asbi
ADMIN_PASS=asbi123

# 1. Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 2. Facebook OAuth 2.0 (https://developers.facebook.com/apps/)
# Redirect URI: http://localhost:5000/api/auth/facebook/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# 3. Email / Gmail OTP via Nodemailer SMTP (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM_NAME=AsbiMart Security

# 4. Bangladesh SMS OTP Gateway (Optional: bulksmsbd / custom)
SMS_PROVIDER=bulksmsbd
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_approved_sender_id

# 5. Real Payment Gateways (bKash Tokenized & SSLCommerz)
MERCHANT_MFS_NUMBER=01821-296056
BKASH_IS_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
